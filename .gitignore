# build.sh output -- large binary disk images, never committed.
# (u-boot/ has its own separate .gitignore for U-Boot's own build tree.)
*.img
*.img.xz
*.img.xz.sha256
*.kpart
*.kpart.sha256
# Generated by build.sh from the pinned u-boot/ submodule -- not the
# project's own LICENSE file at the repo root, which stays tracked.
*-uboot-LICENSE.txt
*-wifi-nvram-LICENSE.txt

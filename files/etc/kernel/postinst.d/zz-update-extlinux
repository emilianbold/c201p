#!/bin/bash
# Regenerate /boot/extlinux/extlinux.conf from the kernels currently in /boot.
#
# Installed into BOTH /etc/kernel/postinst.d/ and /etc/kernel/postrm.d/, and it
# ignores its argument: it always describes what is actually present, so
# installing or removing a kernel both leave a correct config.
#
# The two newest kernels that have a matching initrd get a LABEL each, newest
# first, and DEFAULT points at the newest. This is what gives us rollback: if
# the default entry fails to load, U-Boot walks the remaining labels by itself
# (boot_unattempted_labels() in boot/pxe_utils.c), so a kernel whose files are
# missing or corrupt falls back to the previous one with no interaction. That
# matters on this machine, where U-Boot has no console and no display — a menu
# would be invisible, but the automatic fallback still works. Two is enough
# for that; older kernels are omitted even if still installed.
#
# The limit worth knowing: this only covers failures BEFORE the jump into
# Linux. A kernel that loads and then panics is past U-Boot's reach, and no
# amount of extra labels will help.
#
# The zz- prefix keeps this last in run-parcs order, after initramfs-tools has
# generated the initrd for a newly installed kernel.
set -euo pipefail

BOOT=/boot
CONF="${BOOT}/extlinux/extlinux.conf"
DTB_NAME=rk3288-veyron-speedy.dtb

# Kernels with a matching initrd, newest first.
kernels=()
for k in "${BOOT}"/vmlinuz-*; do
    [ -e "$k" ] || continue
    v="${k##*/vmlinuz-}"
    [ -e "${BOOT}/initrd.img-${v}" ] || continue
    kernels+=("$v")
done

if [ "${#kernels[@]}" -eq 0 ]; then
    # Exit 0 rather than fail: a non-zero postrm wedges dpkg, and refusing to
    # rewrite the config leaves the previous one in place, which is the safer
    # outcome anyway.
    echo "zz-update-extlinux: no kernel with an initrd in ${BOOT}; leaving ${CONF} alone" >&2
    exit 0
fi
# A here-string, not process substitution: process substitution needs
# /dev/fd, which is a symlink into /proc/self/fd/. This script also runs
# inside the qemu-user build chroot (see build.sh Step 6), where /proc isn't
# mounted, and /dev/fd/N fails there with "No such file or directory". A
# here-string is implemented with a temp file instead, so it works in both
# places.
mapfile -t kernels <<< "$(printf '%s\n' "${kernels[@]}" | sort -Vr)"
kernels=("${kernels[@]:0:2}")

# One shared DTB, taken from the newest installed kernel. Older entries boot
# with it too: device trees for this board are stable across kernel versions,
# and keeping a single path avoids changing the layout U-Boot is known to boot.
DTB_SRC=$(find "/usr/lib/linux-image-${kernels[0]}" -name "$DTB_NAME" | head -1)
if [ -n "${DTB_SRC:-}" ]; then
    cp "$DTB_SRC" "${BOOT}/${DTB_NAME}"
elif [ ! -e "${BOOT}/${DTB_NAME}" ]; then
    echo "zz-update-extlinux: no ${DTB_NAME} for ${kernels[0]} and none in ${BOOT}" >&2
    exit 1
fi

mkdir -p "${BOOT}/extlinux"
{
    echo "# Generated by /etc/kernel/postinst.d/zz-update-extlinux — do not edit."
    echo "# Newest kernel first, then the previous one. U-Boot falls through to"
    echo "# the next entry if the default fails to load."
    echo "DEFAULT linux-${kernels[0]}"
    echo "TIMEOUT 30"
    for v in "${kernels[@]}"; do
        echo
        echo "LABEL linux-${v}"
        echo "  KERNEL /boot/vmlinuz-${v}"
        echo "  INITRD /boot/initrd.img-${v}"
        echo "  FDT /boot/${DTB_NAME}"
        echo "  APPEND console=tty0 console=ttyS2,115200n8 root=LABEL=root rw rootwait panic=10"
    done
} > "$CONF"

echo "zz-update-extlinux: ${CONF} lists ${#kernels[@]} kernel(s), default ${kernels[0]}"

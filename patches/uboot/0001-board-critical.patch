 config BOARD_SPECIFIC_OPTIONS # dummy
 	def_bool y
 
+config VEYRON_CHAINLOAD
+	bool "Booted via chainload (skip PMIC/PLL init already done by Depthcharge)"
+	help
+	  When U-Boot is chainloaded by Depthcharge (not booted from SPL),
+	  the RK808 PMIC, ARM PLL, and boot-on regulators are already
+	  configured. Re-running veyron_init() in board_early_init_r()
+	  touches already-initialised I2C and clock hardware and can hang.
+	  Say 'y' when building for a ChromeOS depthcharge→U-Boot flow.
+
 endif
 
